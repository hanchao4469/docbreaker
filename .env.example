# Required service secret: generate your own, at least 32 non-whitespace characters.
DOCBREAKER_API_KEY=replace-with-your-own-secret-of-at-least-32-characters

# Optional. Leave both blank for local-only PDF text extraction.
# Use the root gateway URL, without /v1. Keys are sent only to your configured gateway.
LITELLM_BASE_URL=
LITELLM_API_KEY=
# Separate web image-enrichment credential; empty disables web model enrichment.
LITELLM_WEB_API_KEY=
# Set to an available vision model alias in your gateway.
LITELLM_MODEL=gpt-6-luna

CONCURRENCY=10
MODEL_CONCURRENCY=50
PAGE_CONCURRENCY=10
RENDER_CONCURRENCY=2
UPLOAD_CONCURRENCY=10
QUEUE_SIZE=100
MAX_UPLOAD_MB=50
MAX_PAGES=200
TASK_TIMEOUT_SECONDS=3600
QUEUE_TIMEOUT_SECONDS=7200
PAGE_BUDGET_SECONDS=90
MIN_TASK_TIMEOUT_SECONDS=300
MODEL_TIMEOUT_SECONDS=90
MODEL_RETRIES=1
MODEL_OUTPUT_RETRIES=2
MODEL_MAX_COMPLETION_TOKENS=12000
RENDER_DPI=160
RENDER_MAX_PIXELS=3200
RETENTION_SECONDS=86400
MAX_DATA_MB=4096
